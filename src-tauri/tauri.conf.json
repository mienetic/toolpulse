{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toolpulse",
  "version": "0.1.0",
  "identifier": "com.toolpulse.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mienetic/toolpulse/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4RDNFMTVFM0JDRkNEMUIKUldRYnpjODdYdUhUT0xib2lQV1I1T1RPeFVzdll6dzRVdExabG1nMU9kMDdQQVBEZ1kwd3paaXYK"
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Toolpulse",
        "width": 1100,
        "height": 760,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
